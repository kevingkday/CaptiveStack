# Cloudflare Credentials (for remote D1 & R2 management)
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"
CLOUDFLARE_DATABASE_ID="your-cloudflare-d1-database-id"
CLOUDFLARE_D1_TOKEN="your-cloudflare-d1-api-token"

# R2 / Azure Presigned Storage Credentials (Zero Local Disk Storage)
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net"

# Auth Session Secret
SESSION_SECRET="captivestack-edge-secret-key-32-chars-minimum"
PUBLIC_MEDIA_CDN_URL="https://cdn.captivestack.com"
